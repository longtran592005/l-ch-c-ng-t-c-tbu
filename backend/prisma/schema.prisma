// Prisma Schema for TBU Schedule Management System
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS
// ============================================

model User {
  id           String      @id @default(uuid())
  email        String      @unique @db.VarChar(255)
  passwordHash String      @map("password_hash") @db.VarChar(255)
  name         String      @db.VarChar(255)
  role         String      @default("viewer") @db.VarChar(20)
  department   String?     @db.VarChar(255)
  position     String?     @db.VarChar(255)
  phone        String?     @db.VarChar(20)
  avatar       String?     @db.Text
  status       String      @default("active") @db.VarChar(20)
  
  // Relations
  createdSchedules    Schedule[]          @relation("ScheduleCreator")
  approvedSchedules   Schedule[]          @relation("ScheduleApprover")
  scheduleApprovals   ScheduleApproval[]
  createdNews         News[]
  createdAnnouncements Announcement[]
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  meetingRecords      MeetingRecord[]
  
  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")
  
  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

// ============================================
// SCHEDULES
// ============================================



model Schedule {
  id               String          @id @default(uuid())
  date             DateTime        @db.Date
  dayOfWeek        String          @map("day_of_week") @db.VarChar(20)
  startTime        DateTime          @map("start_time") @db.Time()
  endTime          DateTime?         @map("end_time") @db.Time()
  content          String          @db.Text
  location         String          @db.VarChar(500)
  leader           String          @db.VarChar(255)
  participants     String            @default("[]") @db.Text // JSON array dạng string
  preparingUnit    String          @map("preparing_unit") @db.VarChar(255)
  cooperatingUnits String?           @map("cooperating_units") @default("[]") @db.Text // JSON array dạng string
  status           String  @default("draft") @db.VarChar(20)
  eventType        String?          @map("event_type") @db.VarChar(20) // Loại sự kiện: cuoc_hop, hoi_nghi, tam_ngung
  isSupplementary  Boolean          @default(false) @map("is_supplementary") // Lịch bổ sung
  notes            String?         @db.Text
  
  // Relations
  createdBy    String   @map("created_by")
  creator      User     @relation("ScheduleCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedBy   String?  @map("approved_by")
  approver     User?    @relation("ScheduleApprover", fields: [approvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  approvals    ScheduleApproval[]
  meetingRecords MeetingRecord[]
  
  // Timestamps
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  approvedAt DateTime? @map("approved_at")
  
  @@index([date])
  @@index([status])
  @@index([leader])
  @@index([createdBy])
  @@index([date, status])
  @@map("schedules")
}

// ============================================
// SCHEDULE APPROVALS (Audit Trail)
// ============================================

model ScheduleApproval {
  id            String         @id @default(uuid())
  scheduleId    String         @map("schedule_id")
  schedule      Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  approvedBy    String         @map("approved_by")
  approver      User           @relation(fields: [approvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedAt    DateTime       @default(now()) @map("approved_at")
  previousStatus String? @map("previous_status") @db.VarChar(20)
  newStatus     String @map("new_status") @db.VarChar(20)
  notes         String?        @db.Text
  
  @@index([scheduleId])
  @@index([approvedBy])
  @@map("schedule_approvals")
}

// ============================================
// MEETING RECORDS
// ============================================

model MeetingRecord {
  id                String    @id @default(uuid())
  scheduleId        String    @map("schedule_id")
  schedule          Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  
  // Thông tin cuộc họp
  title             String    @db.VarChar(500)
  meetingDate       DateTime  @map("meeting_date") @db.Date
  startTime         DateTime? @map("start_time") @db.Time()
  endTime           DateTime? @map("end_time") @db.Time()
  location          String?   @db.VarChar(500)
  leader            String?   @db.VarChar(255)
  participants      String    @default("[]") @db.Text // JSON array dạng string
  
  // File ghi âm (JSON array: [{url, filename, duration, uploadedAt, type: 'recorded'|'uploaded'}])
  audioRecordings   String    @default("[]") @db.Text
  
  // Nội dung cuộc họp (rich text)
  content           String?   @db.Text
  
  // Biên bản
  minutes           String?   @db.Text
  
  // Metadata
  createdBy         String    @map("created_by")
  creator           User      @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status            String    @default("draft") @db.VarChar(20) // draft, completed, archived
  notes             String?   @db.Text
  
  // Timestamps
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  completedAt       DateTime? @map("completed_at")
  
  @@index([scheduleId])
  @@index([meetingDate])
  @@index([createdBy])
  @@index([status])
  @@map("meeting_records")
}

// ============================================
// NEWS
// ============================================



model News {
  id          String       @id @default(uuid())
  title       String       @db.VarChar(500)
  summary     String?      @db.Text
  content     String       @db.Text
  image       String?      @db.Text
  category    String @db.VarChar(20)
  authorId    String?      @map("author_id")
  author      User?        @relation(fields: [authorId], references: [id])
  authorName  String?      @map("author_name") @db.VarChar(255) // Denormalized
  views       Int          @default(0)
  publishedAt DateTime     @default(now()) @map("published_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  
  @@index([category])
  @@index([publishedAt(sort: Desc)])
  @@map("news")
}

// ============================================
// ANNOUNCEMENTS
// ============================================



model Announcement {
  id          String               @id @default(uuid())
  title       String               @db.VarChar(500)
  content     String               @db.Text
  priority    String @default("normal") @db.VarChar(20)
  publishedAt DateTime             @default(now()) @map("published_at")
  expiresAt   DateTime?            @map("expires_at")
  attachments String                 @default("[]") @db.Text // JSON array dạng string
  createdBy   String?              @map("created_by")
  creator     User?                @relation(fields: [createdBy], references: [id])
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  
  @@index([priority])
  @@index([publishedAt(sort: Desc)])
  @@index([expiresAt])
  @@map("announcements")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(255)
  message   String   @db.Text
  type      String   @db.VarChar(50) // 'schedule_approved', 'schedule_pending', etc.
  linkedType String?  @map("linked_type") @db.VarChar(50) // 'schedule', 'news', 'announcement'
  linkedId  String?  @map("linked_id") @db.Uuid
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  
  @@index([userId])
  @@index([userId, read])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

// ============================================
// REFRESH TOKENS
// ============================================

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique @db.VarChar(500)
  expiresAt DateTime  @map("expires_at")
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================
// RAG - VECTOR EMBEDDINGS
// ============================================

model VectorEmbedding {
  id           String   @id @default(uuid())
  sourceType   String   @map("source_type") @db.VarChar(50)  // schedule, news, announcement, document
  sourceId     String?  @map("source_id") @db.VarChar(255)
  content      String   @db.Text
  metadata     String?  @db.Text  // JSON
  embedding    Bytes    // PostgreSQL dùng bytea mặc định
  embeddingDim Int      @default(1024) @map("embedding_dim")
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  @@index([sourceType])
  @@index([sourceId])
  @@map("vector_embeddings")
}

// ============================================
// RAG - CHAT HISTORY
// ============================================

model ChatHistory {
  id            String   @id @default(uuid())
  sessionId     String   @map("session_id") @db.VarChar(255)
  userMessage   String   @map("user_message") @db.Text
  botResponse   String   @map("bot_response") @db.Text
  retrievedDocs String?  @map("retrieved_docs") @db.Text  // JSON
  
  createdAt     DateTime @default(now()) @map("created_at")
  
  @@index([sessionId])
  @@index([createdAt(sort: Desc)])
  @@map("chat_history")
}

// ============================================
// WEEKLY NOTES
// ============================================

model WeeklyNote {
  id        String   @id @default(uuid())
  weekNumber Int     @map("week_number")
  year      Int
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  content   String   @db.Text
  noteType  String   @default("general") @map("note_type") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([weekNumber, year])
  @@map("weekly_notes")
}

# ============================================
# TBU Schedule Management - Backend Environment
# ============================================
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/tbu_schedule_db"

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET="your_very_strong_jwt_secret_key_at_least_32_chars"
JWT_REFRESH_SECRET="your_very_strong_jwt_refresh_secret_key_at_least_32_chars"

# ===========================================
# Server
# ===========================================
PORT=3000
CORS_ORIGIN=https://localhost:8080

# ===========================================
# AI Services (Optional)
# ===========================================
# Groq API for AI features
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama3-70b-8192

# Google Gemini API for STT
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Viettel AI STT (Speech-to-Text)
# Lấy token tại: https://viettelai.vn/dashboard/token
VIETTEL_STT_TOKEN=your_viettel_ai_token
VIETTEL_STT_URL=https://viettelai.vn/asr/recognize

# ============================================
# TBU Schedule Management - Backend Environment
# ============================================
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL="sqlserver://localhost:1433;database=tbu_schedule_db;user=YOUR_USER;password=YOUR_PASSWORD;trustServerCertificate=true"

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET="your_very_strong_jwt_secret_key_at_least_32_chars"
JWT_REFRESH_SECRET="your_very_strong_jwt_refresh_secret_key_at_least_32_chars"

# ===========================================
# Server
# ===========================================
PORT=3000
CORS_ORIGIN=https://localhost:8080

# ===========================================
# AI Services (Optional)
# ===========================================
# Groq API for AI features
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama3-70b-8192

# Google Gemini API for STT
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

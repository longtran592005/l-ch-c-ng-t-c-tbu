# ==============================================
# TBU Schedule Management - Deployment Environment
# ==============================================
# Copy file này thành .env trên server trước khi chạy docker compose
#
#   cp .env.deploy.example .env
#   # Chỉnh sửa các giá trị bên dưới
#   docker compose up -d --build
#

# ============================================
# Domain Configuration
# ============================================
DOMAIN=lichcongtactbu.site

# ============================================
# PostgreSQL Database
# ============================================
POSTGRES_DB=tbu_schedule_db
POSTGRES_USER=prisma_user
POSTGRES_PASSWORD=StrongPassword123!

# ============================================
# JWT Authentication (BẮT BUỘC đổi trên production!)
# ============================================
JWT_SECRET=tbu_schedule_jwt_secret_key_very_strong_2024_prod_change_me
JWT_REFRESH_SECRET=tbu_schedule_jwt_refresh_secret_key_very_strong_2024_prod_change_me

# ============================================
# CORS Origin
# ============================================
CORS_ORIGIN=https://lichcongtactbu.site

# ============================================
# AI Services (Optional - để trống nếu không dùng)
# ============================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# ============================================
# Pollinations AI (Optional)
# ============================================
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_MODEL=openai
POLLINATIONS_STT_MODEL=whisper-large-v3

# ============================================
# OpenCode Zen AI (Optional)
# ============================================
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

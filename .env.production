# ============================================
# Production Environment - Frontend (Vite)
# ============================================
# Khi build production, frontend sử dụng relative paths
# tất cả API calls đi qua Nginx reverse proxy

# Không cần port riêng lẻ vì Nginx xử lý routing
VITE_API_PORT=
VITE_PYTHON_API_PORT=

# Production mode - Nginx handles all routing
VITE_API_BASE_URL=/api
VITE_PYTHON_API_URL=/api/proxy/whisper
